func TestService_BoundaryValidation_RED(t *testing.T) {
	ctx := context.Background()
	dummyDB := &gorm.DB{}

	t.Run("fails when code is empty", func(t *testing.T) {
		mockQuery := new(Mock{{ComponentPascal}}Query)
		svc := service.NewService(mockQuery)

		input := &model.{{EntityName}}{
			Code: "",
			Name: "Tên hợp lệ",
		}

		res, err := svc.Create(ctx, dummyDB, input)
		assert.Error(t, err)
		assert.Nil(t, res)

		var valErr *model.ValidationError
		assert.True(t, errors.As(err, &valErr))
	})

	t.Run("fails when name is empty", func(t *testing.T) {
		mockQuery := new(Mock{{ComponentPascal}}Query)
		svc := service.NewService(mockQuery)

		input := &model.{{EntityName}}{
			Code: "VALID_CODE",
			Name: "   ",
		}

		res, err := svc.Create(ctx, dummyDB, input)
		assert.Error(t, err)
		assert.Nil(t, res)
	})

	t.Run("fails when code is duplicate", func(t *testing.T) {
		mockQuery := new(Mock{{ComponentPascal}}Query)
		mockQuery.On("CountByCode", ctx, dummyDB, "DUP_CODE", "").Return(int64(1), nil)

		svc := service.NewService(mockQuery)
		input := &model.{{EntityName}}{
			Code: "DUP_CODE",
			Name: "Tên hợp lệ",
		}

		res, err := svc.Create(ctx, dummyDB, input)
		assert.Error(t, err)
		assert.Nil(t, res)
		mockQuery.AssertExpectations(t)
	})

	t.Run("defensive check: fails when tx is nil", func(t *testing.T) {
		mockQuery := new(Mock{{ComponentPascal}}Query)
		svc := service.NewService(mockQuery)

		input := &model.{{EntityName}}{
			Code: "VALID_CODE",
			Name: "Tên hợp lệ",
		}

		res, err := svc.Create(ctx, nil, input)
		assert.Error(t, err)
		assert.Nil(t, res)
	})
}
