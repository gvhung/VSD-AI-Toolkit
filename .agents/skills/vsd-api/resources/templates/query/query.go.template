func (q *{{ComponentCamel}}Query) Paginate(ctx context.Context, tx *gorm.DB, pageIndex, pageSize int, searchKey string) ([]*model.{{EntityName}}, int64, error) {
	db, err := q.getDB(tx)
	if err != nil {
		return nil, 0, err
	}
	query := db.WithContext(ctx)
	if searchKey != "" {
		key := "%" + searchKey + "%"
		query = query.Where("code ILIKE ? OR name ILIKE ?", key, key)
	}
	var total int64
	if err := query.Count(&total).Error; err != nil {
		return nil, 0, err
	}
	if pageIndex < 1 {
		pageIndex = 1
	}
	if pageSize < 1 {
		pageSize = 20
	}
	offset := (pageIndex - 1) * pageSize
	var items []*model.{{EntityName}}
	err = query.Order("order_index ASC, created_at DESC").Limit(pageSize).Offset(offset).Find(&items).Error
	return items, total, err
}
