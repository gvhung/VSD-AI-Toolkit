// getDB performs defensive nil check on transaction context
func (q *{{ComponentCamel}}Query) getDB(tx *gorm.DB) (*gorm.DB, error) {
	if tx == nil {
		return nil, errors.New("database transaction is required and cannot be nil")
	}
	return tx.Model(&model.{{EntityName}}{}).Where("removed_at IS NULL"), nil
}

func (q *{{ComponentCamel}}Query) FindAll(ctx context.Context, tx *gorm.DB) ([]*model.{{EntityName}}, error) {
	db, err := q.getDB(tx)
	if err != nil {
		return nil, err
	}
	var items []*model.{{EntityName}}
	err = db.WithContext(ctx).Order("order_index ASC, created_at DESC").Find(&items).Error
	return items, err
}

func (q *{{ComponentCamel}}Query) FindByID(ctx context.Context, tx *gorm.DB, id string) (*model.{{EntityName}}, error) {
	db, err := q.getDB(tx)
	if err != nil {
		return nil, err
	}
	var item model.{{EntityName}}
	err = db.WithContext(ctx).Where("id = ?", id).First(&item).Error
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, nil
		}
		return nil, err
	}
	return &item, nil
}

func (q *{{ComponentCamel}}Query) FindByCode(ctx context.Context, tx *gorm.DB, code string) (*model.{{EntityName}}, error) {
	db, err := q.getDB(tx)
	if err != nil {
