func (q *{{ComponentCamel}}Query) CountByCode(ctx context.Context, tx *gorm.DB, code string, excludeID string) (int64, error) {
	db, err := q.getDB(tx)
	if err != nil {
		return 0, err
	}
	query := db.WithContext(ctx).Where("code = ?", code)
	if excludeID != "" {
		query = query.Where("id <> ?", excludeID)
	}
	var count int64
	err = query.Count(&count).Error
	return count, err
}

func (q *{{ComponentCamel}}Query) Create(ctx context.Context, tx *gorm.DB, item *model.{{EntityName}}) error {
	if tx == nil {
		return errors.New("database transaction is required")
	}
	if item == nil {
		return errors.New("cannot create nil item")
	}
	return tx.WithContext(ctx).Create(item).Error
}

