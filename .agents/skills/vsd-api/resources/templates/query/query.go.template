func (q *{{ComponentCamel}}Query) DeleteSoft(ctx context.Context, tx *gorm.DB, id string) (int64, error) {
	db, err := q.getDB(tx)
	if err != nil {
		return 0, err
	}
	res := db.WithContext(ctx).Where("id = ?", id).Update("removed_at", gorm.Expr("NOW()"))
	return res.RowsAffected, res.Error
