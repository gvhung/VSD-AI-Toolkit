<div class="flex flex-col max-h-screen -m-6">
  <!-- Modal Header -->
  <div class="flex items-center justify-between py-4 px-6 bg-primary text-on-primary">
    <div class="text-lg font-semibold tracking-tight">
      {{ isEdit ? 'Cập nhật ' + FIELD_LABELS['name'] : 'Thêm mới ' + FIELD_LABELS['name'] }}
    </div>
    <button mat-icon-button (click)="close()" tabindex="-1">
      <mat-icon [svgIcon]="'heroicons_outline:x-mark'"></mat-icon>
    </button>
  </div>

  <!-- Form Body -->
  <form [formGroup]="form" class="flex flex-col flex-auto p-6 overflow-y-auto gap-4">
    <!-- Code Field -->
    <mat-form-field class="w-full">
      <mat-label>{{ FIELD_LABELS['code'] }}</mat-label>
      <input matInput formControlName="code" required [readonly]="isEdit" placeholder="Nhập mã...">
      <mat-error *ngIf="form.get('code')?.hasError('required')">
        {{ FIELD_LABELS['code'] }} là bắt buộc
      </mat-error>
      <mat-error *ngIf="form.get('code')?.hasError('maxlength')">
        Tối đa 50 ký tự
      </mat-error>
    </mat-form-field>

    <!-- Name Field -->
    <mat-form-field class="w-full">
      <mat-label>{{ FIELD_LABELS['name'] }}</mat-label>
      <input matInput formControlName="name" required placeholder="Nhập tên...">
      <mat-error *ngIf="form.get('name')?.hasError('required')">
        {{ FIELD_LABELS['name'] }} là bắt buộc
      </mat-error>
      <mat-error *ngIf="form.get('name')?.hasError('maxlength')">
        Tối đa 255 ký tự
      </mat-error>
    </mat-form-field>

    <!-- Order Index Field -->
    <mat-form-field class="w-full">
      <mat-label>{{ FIELD_LABELS['order_index'] }}</mat-label>
      <input matInput type="number" formControlName="order_index" placeholder="Thứ tự hiển thị...">
    </mat-form-field>

    <!-- Description Field -->
    <mat-form-field class="w-full">
      <mat-label>{{ FIELD_LABELS['description'] }}</mat-label>
      <textarea matInput formControlName="description" rows="3" placeholder="Mô tả chi tiết..."></textarea>
      <mat-error *ngIf="form.get('description')?.hasError('maxlength')">
        Tối đa 2000 ký tự
      </mat-error>
    </mat-form-field>
  </form>

  <!-- Sticky Footer Action Buttons -->
  <div class="flex items-center justify-end py-4 px-6 border-t bg-gray-50 dark:bg-gray-800 gap-3">
    <button mat-button (click)="close()" [disabled]="isSubmitting">
      Hủy bỏ
    </button>
    <button *ngIf="!isEdit"
            mat-stroked-button color="primary"
            (click)="save(false)"
            [disabled]="form.invalid || isSubmitting">
      Lưu & Thêm mới
    </button>
    <button mat-flat-button color="primary"
            (click)="save(true)"
            [disabled]="form.invalid || isSubmitting">
      <mat-icon *ngIf="isSubmitting" class="animate-spin mr-2" [svgIcon]="'heroicons_outline:arrow-path'"></mat-icon>
      {{ isEdit ? 'Cập nhật' : 'Lưu' }}
    </button>
  </div>
</div>
