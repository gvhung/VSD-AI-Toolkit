<div class="sm:absolute sm:inset-0 flex flex-col flex-auto min-w-0 sm:overflow-hidden bg-card dark:bg-transparent">
  <!-- Header / Toolbar -->
  <div class="relative flex flex-col sm:flex-row flex-0 sm:items-center sm:justify-between py-4 px-6 md:px-8 border-b">
    <div>
      <app-page-header></app-page-header>
    </div>
    <div class="flex shrink-0 items-center mt-3 sm:mt-0 gap-3">
      <!-- Search Input -->
      <mat-form-field class="fuse-mat-dense fuse-mat-rounded min-w-64" [subscriptSizing]="'dynamic'">
        <mat-icon matPrefix [svgIcon]="'heroicons_outline:magnifying-glass'"></mat-icon>
        <input matInput (input)="onSearch($event)" placeholder="Tìm kiếm {{ComponentVN}}...">
      </mat-form-field>

      <!-- Add Button protected by MenuAuth RBAC -->
      <button *ngIf="permissionService.hasPermission('ADD')"
              mat-flat-button [color]="'primary'"
              (click)="openCreateModal()">
        <mat-icon [svgIcon]="'heroicons_outline:plus'"></mat-icon>
        <span class="ml-2">Thêm mới {{ComponentVN}}</span>
      </button>
    </div>
  </div>

  <!-- Table Container -->
  <div class="flex flex-col flex-auto sm:overflow-auto">
    <table mat-table [dataSource]="dataSource" matSort class="w-full">
      <!-- STT Column -->
      <ng-container matColumnDef="stt">
        <th mat-header-cell *matHeaderCellDef class="w-16 text-center">STT</th>
        <td mat-cell *matCellDef="let row; let i = index" class="text-center">
          {{ pageIndex * pageSize + i + 1 }}
        </td>
      </ng-container>

      <!-- Code Column -->
      <ng-container matColumnDef="code">
        <th mat-header-cell *matHeaderCellDef mat-sort-header class="w-40 font-bold">Mã</th>
        <td mat-cell *matCellDef="let row" class="font-medium text-primary">
          {{ row.code }}
        </td>
      </ng-container>

      <!-- Name Column -->
      <ng-container matColumnDef="name">
        <th mat-header-cell *matHeaderCellDef mat-sort-header>Tên {{ComponentVN}}</th>
        <td mat-cell *matCellDef="let row">{{ row.name }}</td>
      </ng-container>

      <!-- Order Index Column -->
      <ng-container matColumnDef="order_index">
        <th mat-header-cell *matHeaderCellDef class="w-24 text-center">Thứ tự</th>
        <td mat-cell *matCellDef="let row" class="text-center">{{ row.order_index || 0 }}</td>
      </ng-container>

      <!-- Actions Column with RBAC Buttons -->
      <ng-container matColumnDef="actions">
        <th mat-header-cell *matHeaderCellDef class="w-28 text-center">Thao tác</th>
        <td mat-cell *matCellDef="let row" class="text-center">
          <div class="flex items-center justify-center gap-1">
            <button *ngIf="permissionService.hasPermission('EDIT')"
                    mat-icon-button color="accent"
                    (click)="openEditModal(row)" title="Chỉnh sửa">
              <mat-icon [svgIcon]="'heroicons_outline:pencil-square'"></mat-icon>
            </button>
            <button *ngIf="permissionService.hasPermission('DELETE')"
                    mat-icon-button color="warn"
                    (click)="deleteItem(row)" title="Xóa">
              <mat-icon [svgIcon]="'heroicons_outline:trash'"></mat-icon>
            </button>
          </div>
        </td>
      </ng-container>

      <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
      <tr mat-row *matRowDef="let row; columns: displayedColumns;" class="hover:bg-gray-50 dark:hover:bg-hover transition-colors"></tr>
    </table>

    <div *ngIf="dataSource.data.length === 0" class="flex flex-col items-center justify-center p-8 text-secondary">
      <span>Không có dữ liệu hiển thị</span>
    </div>
  </div>

  <!-- Paginator -->
  <mat-paginator [length]="totalItems"
                 [pageSize]="pageSize"
                 [pageIndex]="pageIndex"
                 [pageSizeOptions]="[10, 20, 50, 100]"
                 (page)="onPageChange($event)"
                 showFirstLastButtons>
  </mat-paginator>
</div>
